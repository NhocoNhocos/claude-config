{
  "outputStyle": "Simples PT",
  "skillOverrides": {
    "keybindings-help": "off",
    "fewer-permission-prompts": "off",
    "plugin-authoring": "off",
    "startup-hook-skill": "off",
    "session-start-hook": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:import-memory": "off",
    "lemo-opuscar:lemo-opuscar": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/skill-guard.py",
            "asyncRewake": true,
            "timeout": 1800
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/skill-guard.py",
            "asyncRewake": true,
            "timeout": 1800
          }
        ]
      }
    ]
  },
  "env": {
    "PONYTAIL_DEFAULT_MODE": "off"
  }
}
